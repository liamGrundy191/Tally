# Copy to .env and fill in. Never commit .env.

# Database (Postgres 16). Locally, after docker compose -f docker/compose.dev.yml up -d:
# DATABASE_URL=postgresql://tally:tally-dev-only@localhost:5432/tally
DATABASE_URL=

# File storage (S3; MinIO locally: http://localhost:9000, user tally, password tally-dev-only)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Extraction: "fake" (no API key needed) or "anthropic"
EXTRACTOR=
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=
# low | medium | high | xhigh | max: higher reads harder handwriting more carefully, at a higher cost
EXTRACTOR_EFFORT=high
# EXTRACTOR_MODEL defaults to claude-opus-5-5; T0.6 measures accuracy and cost per ticket.

# Review and rule settings (plan defaults: true, 2, 16, 45)
REVIEW_EVERYTHING=
MIN_SHIFT_HOURS=
MAX_SHIFT_HOURS=
MAX_DATE_AGE_DAYS=

# Optional error reporting
SENTRY_DSN=
