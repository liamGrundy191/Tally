# Copy to .env and fill in. Never commit .env.

# The web app's address, used in invite links
APP_URL=http://localhost:5173

# Database (Postgres 16). Locally, after docker compose -f docker/compose.dev.yml up -d:
# DATABASE_URL=postgresql://tally:tally-dev-only@localhost:5432/tally
DATABASE_URL=

# File storage (S3). Locally, the MinIO of docker/compose.dev.yml:
# S3_ENDPOINT=http://localhost:9000, S3_REGION=us-east-1, S3_BUCKET=tally (made by the compose
# file's minio-setup), S3_ACCESS_KEY_ID=tally, S3_SECRET_ACCESS_KEY=tally-dev-only. On AWS, leave S3_ENDPOINT and the keys empty to use the
# server's own AWS role.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# "worker" starts the background worker instead of the API (same code, section 3)
MODE=
# The API's port (default 3000)
PORT=

# Reading: "anthropic", or "fake" for local runs without an API key (every ticket gets one prepared
# answer). Must be set: the worker never picks the fake reader by itself.
EXTRACTOR=
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=
# low | medium | high | xhigh | max: higher reads harder handwriting more carefully, at a higher cost
EXTRACTOR_EFFORT=high
# EXTRACTOR_MODEL defaults to claude-opus-5-5 (D35).

# Review and rule settings (plan defaults: true, 2, 16, 45)
REVIEW_EVERYTHING=
MIN_SHIFT_HOURS=
MAX_SHIFT_HOURS=
MAX_DATE_AGE_DAYS=

# Days a login lasts without use, 1 to 30. Empty: 12 hours. The home laptop sets 30 (D62).
SESSION_IDLE_DAYS=

# Optional error reports (D59). Empty: errors only in the logs. Never set it in tests.
SENTRY_DSN=
# Logs are one JSON line per event when NODE_ENV=production, which the server's image sets (D59).

# --- Production (T4.3, D60) ---
# On the server these live in /opt/tally/.env (mode 600). The secrets (ANTHROPIC_API_KEY, the S3
# keys, both database addresses, SENTRY_DSN) are pasted in with docker/set-secrets.sh, never typed
# into chat or GitHub. The other lines, for example:
#   APP_URL=https://tally.<agency domain>
#   TALLY_VERSION=v1.0.0                (set by each deploy)
#   EXTRACTOR=anthropic
#   REVIEW_EVERYTHING=true              (the pilot)
#   S3_ENDPOINT=                        (empty: AWS itself)
#   S3_REGION=eu-central-1
#   S3_BUCKET=<bucket, no dots>
#   DATABASE_URL=postgresql://tally:<password>@<host>:25060/tally?sslmode=verify-full&sslrootcert=/etc/tally/db-ca.pem
# Prisma's migrate engine writes TLS settings its own way, so migrations get their own address:
#   MIGRATE_DATABASE_URL=postgresql://tally:<password>@<host>:25060/tally?sslmode=require&sslcert=/etc/tally/db-ca.pem&sslaccept=strict
MIGRATE_DATABASE_URL=
