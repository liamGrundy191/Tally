# Copy to .env and fill in. Never commit .env.

# Database (Postgres 16)
DATABASE_URL=

# File storage (S3; MinIO locally)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Extraction: "fake" (no API key needed) or "anthropic"
EXTRACTOR=
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=
# EXTRACTOR_MODEL defaults to claude-opus-5-5; T0.6 measures accuracy and cost per ticket.

# Review and rule settings (plan defaults: true, 2, 16, 45)
REVIEW_EVERYTHING=
MIN_SHIFT_HOURS=
MAX_SHIFT_HOURS=
MAX_DATE_AGE_DAYS=

# AI spending caps in US dollars
SPEND_CAP_JOB_USD=
SPEND_CAP_MONTH_USD=

# Optional error reporting
SENTRY_DSN=
