{
  "name": "@tally/api",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e:seed": "vitest run --config vitest.e2e-seed.config.ts",
    "db:migrate": "prisma migrate deploy",
    "seed:admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/seed-admin.ts",
    "dev:tsc": "tsc -w -p tsconfig.build.json --preserveWatchOutput",
    "dev:api": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch --env-file-if-exists=../../.env dist/main.js",
    "dev:worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch --env-file-if-exists=../../.env --env-file=worker.env dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tally/shared": "workspace:^",
    "argon2": "0.45.2",
    "exceljs": "4.4.0",
    "pdf-lib": "1.17.1",
    "pg-boss": "12.38.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/node": "22.20.5",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "type": "module"
}
