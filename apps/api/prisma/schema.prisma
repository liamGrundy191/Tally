// The data model of docs/PLAN.md section 7. Durations are integer minutes; every table has a
// UUID id, createdAt and updatedAt. A month's rows are deleted with it (section 6.4), so its
// children cascade.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  reviewer
}

enum MonthStatus {
  open
  closing
  closed
}

enum TicketStatus {
  processing
  verified
  needs_review
  needs_manual_entry
  excluded
}

enum VerifiedHow {
  auto
  confirmed
  corrected
  manual
}

enum ExtractionPass {
  A
  B
  C
}

enum ReadSpeed {
  now
  batch
}

enum ListKind {
  workplace
  name
  /// Workers on the *57 pay rate, with their places (D66): only pre-ticks a ticket's box.
  rate57
}

enum DownloadKind {
  excel
  pdfs
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  email        String    @unique
  passwordHash String
  role         Role
  disabledAt   DateTime?
  /// Wrong passwords since the last good one; 10 lock the account for 15 minutes (section 11).
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  sessions        Session[]
  uploads         Upload[]
  closedMonths    Month[]      @relation("closedBy")
  excludedTickets Ticket[]     @relation("excludedBy")
  resolvedFlags   Flag[]       @relation("resolvedBy")
  auditEntries    AuditEntry[]
  downloads       Download[]
}

model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  email     String
  role      Role
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime

  @@index([userId])
}

/// One failed login, for the limit per IP address (section 11). Kept for a day.
model LoginFailure {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ip        String

  @@index([ip, createdAt])
}

/// One calendar month, open about six weeks (6.1). Its summary row outlives the purge.
model Month {
  id                  String      @id @default(uuid()) @db.Uuid
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  year                Int
  month               Int
  status              MonthStatus @default(open)
  closedAt            DateTime?
  closedById          String?     @db.Uuid
  closedBy            User?       @relation("closedBy", fields: [closedById], references: [id])
  summaryTicketCount  Int?
  summaryTotalMinutes Int?
  lastActivityAt      DateTime    @default(now())

  tickets         Ticket[]
  workplaceGroups WorkplaceGroup[]
  morningHours    MorningHours[]
  auditEntries    AuditEntry[]
  downloads       Download[]

  /// A closed month is never reopened, so a month exists at most once.
  @@unique([year, month])
}

/// An uploaded file. Not tied to a month: its tickets join the months of their dates (6c).
model Upload {
  id               String    @id @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  uploadedById     String    @db.Uuid
  uploadedBy       User      @relation(fields: [uploadedById], references: [id])
  originalFilename String
  /// Cleared once the file is split into page images and deleted.
  s3KeyOriginal    String?
  sha256           String    @unique
  mime             String
  pageCount        Int?
  /// Pages that could not be turned into an image, even after retries: scan them again.
  failedPages      Int[]
  /// Read straight away, or through the batch service at half the price (D26, D43).
  speed            ReadSpeed @default(batch)

  tickets Ticket[]
}

model Ticket {
  id               String          @id @default(uuid()) @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  uploadId         String          @db.Uuid
  upload           Upload          @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  /// Set once the date is settled; until then the ticket waits outside any month.
  monthId          String?         @db.Uuid
  month            Month?          @relation(fields: [monthId], references: [id], onDelete: Cascade)
  pageIndex        Int
  /// The page as scanned (JPEG), used in the workplace PDFs; normalised again for each reading.
  s3KeyPage        String
  templateVersion  String?
  /// As read from the ticket.
  firstName        String?
  /// Confirmed, in English letters: the worker's row in the Excel (5.2).
  workerName       String?
  workplaceRaw     String?
  workplaceGroupId String?         @db.Uuid
  workplaceGroup   WorkplaceGroup? @relation(fields: [workplaceGroupId], references: [id])
  shiftDate        DateTime?       @db.Date
  startMinutes     Int?
  endMinutes       Int?
  totalMinutes     Int?
  /// The total was unclear and accepted because start and end confirm it (D30); shown to reviewers.
  totalFromMath    Boolean         @default(false)
  status           TicketStatus    @default(processing)
  verifiedHow      VerifiedHow?
  excludedReason   String?
  excludedById     String?         @db.Uuid
  excludedBy       User?           @relation("excludedBy", fields: [excludedById], references: [id])
  /// The ticket that replaced this one (5.2).
  replacedById     String?         @db.Uuid
  replacedBy       Ticket?         @relation("replacedBy", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         Ticket[]        @relation("replacedBy")
  /// Optimistic locking: a save must name the version it read (409 if stale).
  version          Int             @default(0)
  /// Times the ticket was sent to be read again; a new round is never answered from kept readings.
  readRound        Int             @default(0)
  /// "57 rate" as a person saved it (D66): true puts its hours in a *57 row and column. null until
  /// a person saves the ticket, so the 57 list may tick it only then.
  rate57           Boolean?
  /// The reader's best guesses for flagged fields (D24), shown to the reviewer, never used as values.
  suggestions      Json            @default("{}")

  readings     Reading[]
  flags        Flag[]    @relation("flagTicket")
  relatedFlags Flag[]    @relation("relatedTicket")

  @@unique([uploadId, pageIndex])
  @@index([monthId, status])
}

model WorkplaceGroup {
  id             String           @id @default(uuid()) @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  monthId        String           @db.Uuid
  month          Month            @relation(fields: [monthId], references: [id], onDelete: Cascade)
  displayName    String
  normalisedName String
  mergedIntoId   String?          @db.Uuid
  mergedInto     WorkplaceGroup?  @relation("mergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merged         WorkplaceGroup[] @relation("mergedInto")

  tickets      Ticket[]
  morningHours MorningHours[]

  @@index([monthId])
}

/// The lists that help reading (5.4), shared by all months (D42). They never put a worker or
/// workplace in the Excel.
model ListEntry {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kind      ListKind
  /// A place's Hebrew name, or the English spelling of a worker's name.
  name      String
  /// Every other spelling (e.g. the place in English, the name in Hebrew).
  spellings String[]

  @@unique([kind, name])
}

/// One field as one pass read it. Insert-only for the application.
/// One answer from the reader for one pass, kept whole, so a restarted job reuses it instead of
/// paying for it again (D43). Insert-only; deleted with its ticket.
model Reading {
  id               String         @id @default(uuid()) @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ticketId         String         @db.Uuid
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  pass             ExtractionPass
  /// Which lists the reader was given: the second look at names (D28) has a longer names list.
  listsKey         String
  /// The validated answer: every field's value, legibility and suggestion (D24), and more.
  answer           Json
  model            String
  promptVersion    String
  inputTokens      Int
  outputTokens     Int
  /// The shared start of the request read from, or written to, the cache (D65).
  cacheReadTokens  Int            @default(0)
  cacheWriteTokens Int            @default(0)

  @@unique([ticketId, pass, listsKey])
}

/// A flag code is one of FLAG_CODES in @tally/shared; the database keeps it as text so the list
/// lives in one place.
model Flag {
  id              String    @id @default(uuid()) @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ticketId        String    @db.Uuid
  ticket          Ticket    @relation("flagTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  field           String?
  code            String
  detail          Json
  relatedTicketId String?   @db.Uuid
  relatedTicket   Ticket?   @relation("relatedTicket", fields: [relatedTicketId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolvedById    String?   @db.Uuid
  resolvedBy      User?     @relation("resolvedBy", fields: [resolvedById], references: [id])
  resolution      String?

  @@index([ticketId])
}

/// Insert-only for the application; only the purge deletes entries.
model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  monthId   String?  @db.Uuid
  month     Month?   @relation(fields: [monthId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?

  @@index([monthId])
}

/// Downloads are built on request and never stored; closing needs at least one of each (6.1).
model Download {
  id        String       @id @default(uuid()) @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  monthId   String       @db.Uuid
  month     Month        @relation(fields: [monthId], references: [id], onDelete: Cascade)
  kind      DownloadKind
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id])

  @@index([monthId])
}

/// Hours from the separate morning source, typed by a person (D66). No ticket: they only fill the
/// totals sheet's בוקר column, never a workplace sheet or PDF. Deleted with the month.
model MorningHours {
  id               String         @id @default(uuid()) @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  monthId          String         @db.Uuid
  month            Month          @relation(fields: [monthId], references: [id], onDelete: Cascade)
  /// The place, as a group: a merge or a rename carries the hours along.
  workplaceGroupId String         @db.Uuid
  workplaceGroup   WorkplaceGroup @relation(fields: [workplaceGroupId], references: [id], onDelete: Cascade)
  minutes          Int

  @@index([monthId])
}
