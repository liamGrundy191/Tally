# Settings for the local production rehearsal (docker/compose.local.yml). Local-only values, no
# secrets: the passwords below exist only in the throwaway containers of that rehearsal.
TALLY_VERSION=local
APP_URL=https://tally.localhost:8443
DATABASE_URL=postgresql://tally:tally-local-only@postgres:5432/tally_local
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=tally-local
S3_ACCESS_KEY_ID=tally
S3_SECRET_ACCESS_KEY=tally-local-only
EXTRACTOR=fake
REVIEW_EVERYTHING=true
