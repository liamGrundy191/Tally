{
  "name": "tally",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "ticket:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/shared/src/templates/ticket-pdf.ts",
    "extract": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env tools/poc/src/extract-one.ts",
    "crops": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/poc/src/crops.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
